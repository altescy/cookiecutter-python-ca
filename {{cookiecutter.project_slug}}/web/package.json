{
  "name": "{{ cookiecutter.project_slug }}-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --bun vite",
    "build": "tsc -b && bun run --bun vite build",
    "lint": "biome lint src && tsc --noEmit && bun run lint:architecture",
    "lint:architecture": "bun run --bun steiger ./src",
    "format": "biome format --write src",
    "test": "bun run --bun vitest run --passWithNoTests",
    "generate-api": "bun run --bun openapi-ts"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@hey-api/openapi-ts": "^0.99.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "steiger": "^0.7.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
