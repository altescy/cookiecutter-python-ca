{
  "name": "{{ cookiecutter.project_slug }}-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "tsc -b && vite build",
    "lint": "biome lint src && tsc --noEmit && bun run lint:architecture",
    "lint:architecture": "bun run --bun steiger ./src",
    "format": "biome format --write src",
    "test": "vitest run --passWithNoTests",
    "generate-api": "openapi-ts"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@hey-api/openapi-ts": "^0.64.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "steiger": "^0.7.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
